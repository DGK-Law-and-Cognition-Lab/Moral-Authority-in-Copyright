uba54\ub9ac\uce74 \uc778\ub514\uc5b8\/\uc544\uba54\ub9ac\uce74 \uc6d0\uc8fc\ubbfc \ub610\ub294 \uc54c\ub798\uc2a4\uce74 \uc6d0\uc8fc\ubbfc"},"4":{"Display":"\uc544\uc2dc\uc544\uc778"},"5":{"Display":"\ud558\uc640\uc774 \uc6d0\uc8fc\ubbfc \ub610\ub294 \uae30\ud0c0 \ud0dc\ud3c9\uc591\uc758 \uc12c \uc8fc\ubbfc"},"6":{"Display":"\uae30\ud0c0"},"7":{"Display":"\uc5b8\uae09 \uc548 \ud568"}},"QuestionText":"\ubcf8\uc778\uc774 \ud574\ub2f9\ub41c\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uc778\uc885\uc744 \ud558\ub098 \uc774\uc0c1 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."},"NL":{"Choices":{"1":{"Display":"Blank"},"2":{"Display":"Zwart of Afro-Amerikaans"},"3":{"Display":"Amerikaans Indiaans\/native Amerikaans of afkomstig uit Alaska"},"4":{"Display":"Aziatisch"},"5":{"Display":"Geboren op Hawa\u00ef of een ander eiland in de Stille Oceaan"},"6":{"Display":"Anders"},"7":{"Display":"Ik antwoord liever niet"}},"QuestionText":"Kies een of meerdere rassen waartoe u volgens uzelf behoort"},"PT-BR":{"Choices":{"1":{"Display":"Branco ou caucasiano"},"2":{"Display":"Negro ou afro-americano"},"3":{"Display":"Amer\u00edndio\/Nativo americano ou nativo do Alasca"},"4":{"Display":"Asi\u00e1tico"},"5":{"Display":"Nativo do Hava\u00ed ou de outra ilha do Pac\u00edfico"},"6":{"Display":"Outro"},"7":{"Display":"Prefiro n\u00e3o dizer"}},"QuestionText":"Escolha uma ou mais ra\u00e7as com as quais voc\u00ea se identifica"},"ZH-S":{"Choices":{"1":{"Display":"\u767d\u4eba\u6216\u9ad8\u52a0\u7d22\u4eba"},"2":{"Display":"\u9ed1\u4eba\u6216\u975e\u6d32\u88d4\u7f8e\u56fd\u4eba"},"3":{"Display":"\u7f8e\u6d32\u5370\u7b2c\u5b89\u4eba\/\u5370\u7b2c\u5b89\u4eba\u6216\u963f\u62c9\u65af\u52a0\u539f\u4f4f\u6c11"},"4":{"Display":"\u4e9a\u88d4"},"5":{"Display":"\u590f\u5a01\u5937\u571f\u8457\u6216\u5176\u4ed6\u592a\u5e73\u6d0b\u5c9b\u6c11"},"6":{"Display":"\u5176\u4ed6"},"7":{"Display":"\u4fdd\u5bc6"}},"QuestionText":"\u9009\u62e9\u60a8\u8ba4\u4e3a\u81ea\u5df1\u6240\u5c5e\u7684\u4e00\u4e2a\u6216\u591a\u4e2a\u79cd\u6