/\/Field\/id}","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"SurveyName":"FairUseAuthority - Final - Study 1","ProtectSelectionIds":true}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Welcome to the Artistic Perception Study! \u00a0 Please click \"Next\" to begin.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:19px;\"><b>Welcome to the Artistic Perception Study!<\/b><\/span><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:19px;\">Please click \"Next\" to begin.<\/span><\/div>","DefaultChoices":false,"DataExportTag":"Welcome","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome to the Artistic Perception Study! \u00a0 Please click \"Next\" to begin.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"What is your task in this experiment?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your task in this experiment?","DefaultChoices":false,"DataExportTag":"AttentionCheck1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your task in this experiment?","Choices":{"1":{"Display":"Ranking our favorite football teams"},"2":{"Display":"Viewing images for a set amount of time and answering questions"},"3":{"Display":"Watching a movie for a set amount of time"},"4":{"Display":"Reading scenarios about artists"},"5":{"Display":"Discussing your favorite foods"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID13","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID13\/SelectableChoice\/4","Operator":"Selected","QuestionIDFromLocator":"QID13","LeftOperand":"q:\/\/QID13\/SelectableChoice\/4","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">What is your task in this experiment?<\/span> <span class=\"LeftOpDesc\">Reading scenarios about artists<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":null,"subMessageID":"VE_ERROR","libraryID":null,"description":"Error Text"}}}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID13","Randomization":{"Advanced":null,"Type":"All","TotalRandSubset":""}}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"You did not answer the question correctly. Please read the instructions again.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>You did not answer the question correctly. Please read the instructions again.<\/b><\/div>","DefaultChoices":false,"DataExportTag":"NoGo","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You did not answer the question correctly. Please read the instructions again.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"You will now proceed to the main part of the study. \u00a0 Before you continue, please note: Read care..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>You will now proceed to the main part of the study.<\/b><br>\n&nbsp;\n<p><strong>Before you continue, please note:<\/strong><\/p><p><strong><br><\/strong><\/p>\n<strong>Read carefully:<\/strong> In the next section, you will see a scenario describing a specific situation. Please take your time to read and understand all the details. The details matter for answering the questions that follow.<\/div><div style=\"text-align: center;\"><br>\n<strong>You cannot go back:<\/strong> Once you move past the scenario to the questions, you will NOT be able to return to re-read it. Make sure you fully understand the situation before clicking \"Next.\"<\/div><div style=\"text-align: center;\"><br>\n<strong>Take your time:<\/strong> There is no time limit. Read at your own pace and make sure you understand what happened in the scenario.<\/div>","DefaultChoices":false,"DataExportTag":"Q15","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now proceed to the main part of the study. \u00a0 Before you continue, please note: Read care...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Who created the new artwork?","TertiaryAttribute":null,"Payload":{"QuestionText":"Who created the new artwork?","DefaultChoices":false,"DataExportTag":"WhoNewCheck","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Who created the new artwork?","Choices":{"1":{"Display":"Alex Martinez"},"2":{"Display":"Jamie Rivera"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID16","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"What reason did Alex Martinez give for not getting permission from Jamie Rivera? ","TertiaryAttribute":null,"Payload":{"QuestionText":"What reason did Alex Martinez give for not getting permission from Jamie Rivera?&nbsp;","DefaultChoices":false,"DataExportTag":"ReasonWhyCheck","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What reason did Alex Martinez give for not getting permission from Jamie Rivera? ","Choices":{"1":{"Display":"The work was for educational purposes"},"2":{"Display":"The new artwork was different enough from the original"},"3":{"Display":"No reason was given"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID17","Randomization":{"Advanced":null,"Type":"All","TotalRandSubset":""}}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720292887","SecondaryAttribute":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and artistic and aesthetic judgment, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.\n<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human artistic perception and cognition.\n<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and artistic background. You may be presented with different types of visual art and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.\n<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand aesthetic judgements in the law. By understanding the processes underlying human perception, we can better consider the fundamentals of copyright and the burgeoning field of AI art.  \n<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 0.5 to 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $16 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563. <br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","Choices":{"1":{"Display":"I consent to this study."},"2":{"Display":"I do not consent to this study."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and artistic and aesthetic judgment, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.\n<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human artistic perception and cognition.\n<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and artistic background. You may be presented with different types of visual art and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.\n<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand aesthetic judgements in the law. By understanding the processes underlying human perception, we can better consider the fundamentals of copyright and the burgeoning field of AI art.  \n<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 0.5 to 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $16 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563. <br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DataExportTag":"Consent","QuestionID":"QID1720292887"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720292888","SecondaryAttribute":"Date of Consent:","TertiaryAttribute":null,"Payload":{"QuestionText":"Date of Consent:","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Date of Consent:","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Date of Consent:","DataExportTag":"Q2","QuestionID":"QID1720292888"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720292889","Secon