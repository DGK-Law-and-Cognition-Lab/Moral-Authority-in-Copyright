tTag":"Gender","QuestionID":"QID1720293457"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293458","SecondaryAttribute":"What is your age?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age?","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"What is your age?","DataExportTag":"Age","QuestionID":"QID1720293458"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293459","SecondaryAttribute":"What is your native language?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your native language?","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your native language?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"What is your native language?","DataExportTag":"NativeLanguage","QuestionID":"QID1720293459"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293460","SecondaryAttribute":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your level of formal artistic training or experience, such as painting, drawing, sculpture, ceramics, photography, and\/or film-video?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","Choices":{"1":{"Display":"No formal training or experience"},"4":{"Display":"A little formal training or experience"},"5":{"Display":"Moderate formal training or experience"},"6":{"Display":"Extensive formal training or experience"},"7":{"Display":"Very extensive formal training or experience"}},"ChoiceOrder":["1","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"What is your level of formal artistic training or experience, such as painting, drawing, sculpture, ceramics, photography, and\/or film-video?","DataExportTag":"ArtTraining","QuestionID":"QID1720293460"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293461","SecondaryAttribute":"Is there anything else you would like to share with us? If not, type NA.","TertiaryAttribute":null,"Payload":{"QuestionText":"Is there anything else you would like to share with us? If not, type NA.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is there anything else you would like to share with us? If not, type NA.","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Is there anything else you would like to share with us? If not, type NA.","DataExportTag":"SharingAnything","QuestionID":"QID1720293461"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293462","SecondaryAttribute":"Thank you for completing this study! What was this study about? This research examines how the fa...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Thank you for completing this study!<\/div>\n\n<div style=\"text-align: left;\"><strong><br><\/strong><\/div><div style=\"text-align: left;\"><strong>What was this study about?<\/strong><br>\nThis research examines how the fame and status of individuals involved in copyright situations influences people's judgments about fairness, morality, and harm. The scenario you read was fictional but was inspired by real-world debates about fair use in art and photography.<br>\n<br>\n<strong>Why does this matter?<\/strong><br>\nUnderstanding how people think about these situations can inform legal practices and help us better understand the role of social factors in copyright judgments.<\/div>\n<br>\nIf you have any questions, <b>please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.<\/b>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for completing this study! What was this study about? This research examines how the fa...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current legal standards state that anything produced with artificial intelligence is insufficiently creative, even if you use AI as a base against which you create new work. There is ongoing litigation against the US Copyright Office with an analogous set of facts that you have seen here. If you have any questions, please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.","DataExportTag":"Debrief","QuestionID":"QID1720293462"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720293463","SecondaryAttribute":"Please select the \"Next\" button to complete the experiment.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Please select the \"Next\" button to complete the experiment.<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the \"Next\" button to complete the experiment.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">Please select the &quot;arrow&quot; button to complete the experiment<\/div>","DataExportTag":"EndArrow","QuestionID":"QID1720293463"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311575","SecondaryAttribute":"You have now completed the main experiment, and are progressing onto debriefing questions.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">You have now completed the main experiment, and are progressing onto debriefing questions.<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You have now completed the main experiment, and are progressing onto debriefing questions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">You have now completed the main experiment, and are progressing onto debriefing questions.<\/div>","DataExportTag":"Q1","QuestionID":"QID1720311575"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311576","SecondaryAttribute":"Did you complete this experiment seriously throughout (without responding randomly)?","Tertiar