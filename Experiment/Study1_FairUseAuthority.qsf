2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"What is your gender?","DataExportTag":"Q5","QuestionID":"QID1720311579"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311580","SecondaryAttribute":"What is your age?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age?","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"What is your age?","DataExportTag":"Q6","QuestionID":"QID1720311580"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311581","SecondaryAttribute":"What is your native language?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your native language?","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your native language?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"What is your native language?","DataExportTag":"Q7","QuestionID":"QID1720311581"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311582","SecondaryAttribute":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your level of formal artistic training or experience, such as painting, drawing, sculpture, ceramics, photography, and\/or film-video?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","Choices":{"1":{"Display":"No formal training or experience"},"4":{"Display":"A little formal training or experience"},"5":{"Display":"Moderate formal training or experience"},"6":{"Display":"Extensive formal training or experience"},"7":{"Display":"Very extensive formal training or experience"}},"ChoiceOrder":["1","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"What is your level of formal artistic training or experience, such as painting, drawing, sculpture, ceramics, photography, and\/or film-video?","DataExportTag":"Q8","QuestionID":"QID1720311582"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311583","SecondaryAttribute":"How familiar are you with copyright law and \"fair use\"?","TertiaryAttribute":null,"Payload":{"QuestionText":"How familiar are you with copyright law and \"fair use\"?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"familiar","Type":"likert","Reverse":false}}},"QuestionDescription":"How familiar are you with copyright law and \"fair use\"?","Choices":{"1":{"Display":"Not familiar at all"},"2":{"Display":"Slightly familiar"},"3":{"Display":"Moderately familiar"},"4":{"Display":"Very familiar"},"5":{"Display":"Extremely familiar"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionText_Unsafe":"How familiar are you with copyright law and \"fair use\"?","DataExportTag":"Q9","QuestionID":"QID1720311583"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311584","SecondaryAttribute":"Is there anything else you would like to share with us? If not, type NA.","TertiaryAttribute":null,"Payload":{"QuestionText":"Is there anything else you would like to share with us? If not, type NA.","DefaultChoices":false,"QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Is there anything else you would like to share with us? If not, type NA.","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Is there anything else you would like to share with us? If not, type NA.","DataExportTag":"Q10","QuestionID":"QID1720311584"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311585","SecondaryAttribute":"Thank you for completing this study! What was this study about? This research examines how the fa...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><meta charset=\"UTF-8\" \/><\/div>\n<br \/>\n<b>Thank you for completing this study!<br \/>\n<br \/>\n<strong>What was this study about?<\/strong><\/b><br \/>\nThis research examines how the fame and status of individuals involved in copyright situations influences people&#39;s judgments about fairness, morality, and harm. The scenario you read was fictional but was inspired by real-world debates about fair use in art and photography.<br \/>\n<br \/>\n<b><strong>Why does this matter?<\/strong><\/b><br \/>\nUnderstanding how people think about these situations can inform legal practices and help us better understand the role of social factors in copyright judgments.<br \/>\nIf you have any questions,&nbsp;please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for completing this study! What was this study about? This research examines how the fa...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">Thank you for completing this study!<\/div>\n\n<div style=\"text-align: left;\"><strong><br><\/strong><\/div><div style=\"text-align: left;\"><strong>What was this study about?<\/strong><br>\nThis research examines how the fame and status of individuals involved in copyright situations influences people's judgments about fairness, morality, and harm. The scenario you read was fictional but was inspired by real-world debates about fair use in art and photography.<br>\n<br>\n<strong>Why does this matter?<\/strong><br>\nUnderstanding how people think about these situations can inform legal practices and help us better understand the role of social factors in copyright judgments.<\/div>\n<br>\nIf you have any questions, <b>please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.<\/b>","DataExportTag":"Q11","QuestionID":"QID1720311585"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID1720311586","SecondaryAttribute":"Please select the \"Next\" button to complete the experiment.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Please select the \"Next\" button to complete the experiment.<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the \"Next\" button to complete the experiment.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">Please select the \"Next\" button to complete the experiment.<\/div>","DataExportTag":"Q12","QuestionID":"QID1720311586"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"One or both of your responses was incorrect. Please re-read the passage.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>One or both of your responses was incorrect. Please re-read the passage.<\/b><\/div>","DefaultChoices":false,"DataExportTag":"CheckReadingNoGo","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"One or both of your responses was incorrect. Please re-read the passage.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID18"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Should Alex Martinez be legally allowed to sell this collage without Jamie Rivera's permission?","TertiaryAttribute":null,"Payload":{"QuestionText":"Should Alex Martinez be legally allowed to sell this collage <i>without<\/i> Jamie Rivera's permission?","DefaultChoices":false,"DataExportTag":"AllowedReason","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Should Alex Martinez be legally allowed to sell this collage without Jamie Rivera's permission?","Choices":{"1":{"Display":"Definitely SHOULD NOT be allowed"},"2":{"Display":"Probably SHOULD NOT be allowed"},"3":{"Display":"Uncertain"},"4":{"Display":"Probably SHOULD be allowed"},"5":{"Display":"Definitely SHOULD be allowed"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID19"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\"><b id=\"docs-internal-guid-dc131fad-7fff-148c-009d-3b567858abe2\"><span style=\"font-size:19px;\">CONSENT FORM<\/span><br>\nYou are invited to participate in a research study on human thinking and artistic and aesthetic judgment, conducted by Dr. David G. Kamper of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-a139b2d3-7fff-8769-b53d-8b946908ac28\"><span style=\"font-size:19px;\">Purpose of Study<\/span><br>\nThe purpose of the study is to understand how humans perceive responsibility in AI training decisions.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<span style=\"font-size:19px;\"><b id=\"docs-internal-guid-d688918b-7fff-1f86-122e-046559503fb9\">Procedures Involved in Study<\/b><\/span><br>\n<b id=\"docs-internal-guid-d688918b-7fff-1f86-122e-046559503fb9\">If you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, and language. You may be given a set amount of time to read vignettes and asked to answer questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-cc33db7c-7fff-6e94-5a53-d76205173d62\"><span style=\"font-size:19px;\">Potential Risks and Discomforts<\/span><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<span style=\"font-size:19px;\"><b id=\"docs-internal-guid-a8767ed0-7fff-1e2a-08e0-d8bc98b1fe96\">Potential Benefits to Subject<\/b><\/span><br>\n<b id=\"docs-internal-guid-a8767ed0-7fff-1e2a-08e0-d8bc98b1fe96\">There are no direct benefits from participating in this study.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<span style=\"font-size:19px;\"><b id=\"docs-internal-guid-a8767ed0-7fff-1e2a-08e0-d8bc98b1fe96\">Potential Benefits to Society<\/b><\/span><br>\n<b id=\"docs-internal-guid-a8767ed0-7fff-1e2a-08e0-d8bc98b1fe96\">The findings of the study will help us understand how humans perceive responsibility in AI training decisions, which can help illuminate legal liability judgments involving actions of AI agents.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\"><span style=\"font-size:19px;\">Payment for Participation<\/span><br>\nYou will receive 0.5 to 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $16 per hour for your participation.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\"><span style=\"font-size:19px;\">Alternatives to Participation<\/span><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\"><span style=\"font-size:19px;\">Confidentiality<\/span><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<\/b><\/p>\n\n<p dir=\"ltr\"><b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\">The researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<\/b><\/p>\n\n<p dir=\"ltr\"><br>\n<b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\"><span style=\"font-size:19px;\">Participation and Withdrawal<\/span><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<\/b><\/p>\n\n<p>&nbsp;<\/p>\n\n<p dir=\"ltr\"><b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\">Identification of Investigators<br>\nIf you have any questions, feel free to contact Investigator David G. Kamper (davidgkamper@ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563.<br>\n<br>\nRights of Research Subjects<br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<\/b><\/p>\n\n<p><b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\">UCLA Office of the Human Research Protection Program (OHRPP)<\/b><\/p>\n\n<p dir=\"ltr\"><b id=\"docs-internal-guid-79ac4491-7fff-e518-7b80-b974184e6f28\">If you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.<\/b><\/p>","DefaultChoices":false,"DataExportTag":"Q2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Autoscale":{"YScale":{"Name":"maleFemale","Type":"likert","Reverse":false}}},"QuestionDescription":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","Choices":{"1":{"Display":"Yes, I consent to this study"},"2":{"Display":"No, I do not consent to this study"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID2"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"Martinez sold the artwork for $500 per print. How much does this affect whether the use should be...","TertiaryAttribute":null,"Payload":{"QuestionText":"Martinez sold the artwork for $500 per print. How much does this affect whether the use should be legally allowed?","DefaultChoices":false,"DataExportTag":"CostReason","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Martinez sold the artwork for $500 per print. How much does this affect whether the use should be...","Choices":{"1":{"Display":"Makes it much less acceptable to allow"},"2":{"Display":"Makes it somewhat less acceptable to allow"},"3":{"Display":"Doesn't affect whether it should be allowed"},"4":{"Display":"Makes it somewhat more acceptable to allow"},"5":{"Display":"Makes it much more acceptable to allow"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID20"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Do you think Martinez's artwork would reduce the market value of Rivera's original photograph?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you think Martinez's artwork would reduce the market value of Rivera's original photograph?","DefaultChoices":false,"DataExportTag":"ReduceMarket","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you think Martinez's artwork would reduce the market value of Rivera's original photograph?","Choices":{"1":{"Display":"Would definitely reduce the value"},"2":{"Display":"Would probably reduce the value"},"3":{"Display":"Would not affect the value"},"4":{"Display":"Would somewhat increase the value"},"5":{"Display":"Would probably increase the value"},"6":{"Display":"Would definitely increase the value"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"If you were on a jury, who would you rule in favor of?","TertiaryAttribute":null,"Payload":{"QuestionText":"If you were on a jury, who would you rule in favor of?","DefaultChoices":false,"DataExportTag":"Jury","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you were on a jury, who would you rule in favor of?","Choices":{"1":{"Display":"Strongly in favor of Rivera (photographer)"},"2":{"Display":"Moderately in favor of Rivera (photographer)"},"3":{"Display":"Uncertain \/ Both have equal claims"},"4":{"Display":"Moderately in favor of Martinez (visual artist)"},"5":{"Display":"Strongly in favor of Martinez (visual artist)"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID22"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Explain your reasoning for your ruling.","TertiaryAttribute":null,"Payload":{"QuestionText":"Explain your reasoning for your ruling.","DefaultChoices":false,"DataExportTag":"Explain_Ruling","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Explain your reasoning for your ruling.","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID23"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"How wrong was Martinez's action of using Rivera's photograph to create and sell this artwork?","TertiaryAttribute":null,"Payload":{"QuestionText":"How wrong was Martinez's action of using Rivera's photograph to create and sell this artwork?","DefaultChoices":false,"DataExportTag":"MorallyWrong","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How wrong was Martinez's action of using Rivera's photograph to create and sell this artwork?","Choices":{"1":{"Display":"Not at all morally wrong"},"2":{"Display":"Slightly morally wrong"},"3":{"Display":"Moderately morally wrong"},"4":{"Display":"Very morally wrong"},"5":{"Display":"Completely morally wrong"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID24"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"To what extent is Rivera a victim in this situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"To what extent is Rivera a victim in this situation?","DefaultChoices":false,"DataExportTag":"VictimRivera","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"To what extent is Rivera a victim in this situation?","Choices":{"1":{"Display":"Not a victim at all"},"2":{"Display":"Somewhat a victim"},"3":{"Display":"Moderately a victim"},"4":{"Display":"Considerably a victim"},"5":{"Display":"Completely a victim"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID25"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Do you think Martinez was aware that Rivera might object to this use?","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you think Martinez was aware that Rivera might object to this use?","DefaultChoices":false,"DataExportTag":"ObjectKnowledge","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you think Martinez was aware that Rivera might object to this use?","Choices":{"1":{"Display":"Definitely was not aware"},"2":{"Display":"Probably was not aware"},"3":{"Display":"Uncertain"},"4":{"Display":"Probably was aware"},"5":{"Display":"Definitely was aware"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID26"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"How unfair was Martinez's treatment of Rivera?","TertiaryAttribute":null,"Payload":{"QuestionText":"How unfair was Martinez's treatment of Rivera?","DefaultChoices":false,"DataExportTag":"Unfairness","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How unfair was Martinez's treatment of Rivera?","Choices":{"1":{"Display":"Not at all unfair"},"2":{"Display":"Slightly unfair"},"3":{"Display":"Moderately unfair"},"4":{"Display":"Very unfair"},"5":{"Display":"Completely unfair"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID27"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Did Martinez violate Rivera's rights as a photographer?","TertiaryAttribute":null,"Payload":{"QuestionText":"Did Martinez violate Rivera's rights as a photographer?","DefaultChoices":false,"DataExportTag":"RightsViolation","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Did Martinez violate Rivera's rights as a photographer?","Choices":{"1":{"Display":"Did not violate rights at all"},"2":{"Display":"Minimally violated rights"},"3":{"Display":"Moderately violated rights"},"4":{"Display":"Greatly violated rights"},"5":{"Display":"Completely violated rights"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID28"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"How much punishment, if any, does Martinez deserve?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much punishment, if any, does Martinez deserve?","DefaultChoices":false,"DataExportTag":"Punishment","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much punishment, if any, does Martinez deserve?","Choices":{"1":{"Display":"No punishment at all"},"2":{"Display":"Very little punishment"},"3":{"Display":"A moderate amount of punishment"},"4":{"Display":"Severe punishment"},"5":{"Display":"Maximum punishment"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"You will now read a brief scenario involving an artist and a photographer.\u00a0 After reading the sce..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-size:19px;\">You will now read a brief scenario involving an artist and a photographer.&nbsp;<\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size:19px;\"><br><\/span><\/div><div style=\"text-align: center;\"><span style=\"font-size:19px;\">After reading the scenario, you will be asked several questions about your thoughts and opinions on the situation.&nbsp;<\/span><\/div>","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now read a brief scenario involving an artist and a photographer.\u00a0 After reading the sce...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Should Martinez have to pay Rivera for using the photograph?","TertiaryAttribute":null,"Payload":{"QuestionText":"Should Martinez have to pay Rivera for using the photograph?","DefaultChoices":false,"DataExportTag":"Payment","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Should Martinez have to pay Rivera for using the photograph?","Choices":{"1":{"Display":"Definitely should NOT have to pay"},"2":{"Display":"Probably should not have to pay"},"3":{"Display":"Uncertain"},"4":{"Display":"Probably should have to pay"},"5":{"Display":"Definitely should have to pay"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID30"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q31","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"What, if anything, do you think Martinez should have done differently?","TertiaryAttribute":null,"Payload":{"QuestionText":"What, if anything, do you think Martinez should have done differently?","DefaultChoices":false,"DataExportTag":"Explain_Differently","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What, if anything, do you think Martinez should have done differently?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID32"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"How much financial harm (lost income, lost opportunities) did Rivera experience?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much financial harm (lost income, lost opportunities) did Rivera experience?","DefaultChoices":false,"DataExportTag":"FinancialHarm","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much financial harm (lost income, lost opportunities) did Rivera experience?","Choices":{"1":{"Display":"No financial harm"},"2":{"Display":"Small financial harm"},"3":{"Display":"Moderate financial harm"},"4":{"Display":"Major financial harm"},"5":{"Display":"Severe financial harm"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID33"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"How much harm was done to Rivera's reputation as a photographer?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much harm was done to Rivera's reputation as a photographer?","DefaultChoices":false,"DataExportTag":"ReputationHarm","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much harm was done to Rivera's reputation as a photographer?","Choices":{"1":{"Display":"No reputational harm"},"2":{"Display":"Small reputational harm"},"3":{"Display":"Moderate reputational harm"},"4":{"Display":"Major reputational harm"},"5":{"Display":"Severe reputational harm"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID34"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID35","SecondaryAttribute":"How much emotional distress do you think Rivera experienced?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much emotional distress do you think Rivera experienced?","DefaultChoices":false,"DataExportTag":"EmotionalDistress","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much emotional distress do you think Rivera experienced?","Choices":{"1":{"Display":"No emotional distress"},"2":{"Display":"Small emotional distress"},"3":{"Display":"Moderate emotional distress"},"4":{"Display":"Major emotional distress"},"5":{"Display":"Severe emotional distress"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID35"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID36","SecondaryAttribute":"In general, how much harm did Rivera suffer in this situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"In general, how much harm did Rivera suffer in this situation?","DefaultChoices":false,"DataExportTag":"OverallHarm","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In general, how much harm did Rivera suffer in this situation?","Choices":{"1":{"Display":"No harm at all"},"2":{"Display":"Minimal harm"},"3":{"Display":"Moderate harm"},"4":{"Display":"Considerable harm"},"5":{"Display":"Severe harm"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID36"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q37","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID37"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID38","SecondaryAttribute":"How much status does Martinez (the artist) have in the art world?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much status does Martinez (the artist) have in the art world?","DefaultChoices":false,"DataExportTag":"Status","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much status does Martinez (the artist) have in the art world?","Choices":{"1":{"Display":"Very low status"},"2":{"Display":"Somewhat low status"},"3":{"Display":"Moderate status"},"4":{"Display":"Somewhat high status"},"5":{"Display":"Very high status"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID38"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"How much power did Rivera (the photographer) have to stop Martinez from using the photograph?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much power did Rivera (the photographer) have to stop Martinez from using the photograph?","DefaultChoices":false,"DataExportTag":"PowertoStop","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much power did Rivera (the photographer) have to stop Martinez from using the photograph?","Choices":{"1":{"Display":"No power at all"},"2":{"Display":"Some power"},"3":{"Display":"Moderate power"},"4":{"Display":"Considerable power"},"5":{"Display":"Complete power"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID39"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"Alex Martinez is a world-renowned visual artist whose work has been featured in major internation...","TertiaryAttribute":null,"Payload":{"QuestionText":"Alex Martinez is <b>a world-renowned visual artist<\/b> whose work has been featured in major international museums. Martinez has a large following.<br><br>Recently, Martinez created a new artwork using a photograph originally taken by Jamie Rivera, <b>a widely celebrated and influential photographer<\/b>. Rivera has a large following.<br><br>Rivera's photograph showed a landscape scene. In the new artwork, Martinez changed the colors of Rivera's photograph and added text over it.<br><br>Martinez sold prints of this new collage for $500 each.\n<br><br>Martinez did not ask Rivera for permission or offer any payment. <br><br>When Rivera objected, Martinez stated that the new artwork was different enough from the original photograph that it should be legally protected as \"fair use.\"\n<br><br>Regardless, Martin's artwork was displayed in a gallery.<br>","DefaultChoices":false,"DataExportTag":"Famous - Famous","QuestionID":"QID4","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex Martinez is a world-renowned visual artist whose work has been featured in major internation...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"Who had more resources (money, lawyers, connections) in this situation?","TertiaryAttribute":null,"Payload":{"QuestionText":"Who had more resources (money, lawyers, connections) in this situation?","DefaultChoices":false,"DataExportTag":"Resources","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Who had more resources (money, lawyers, connections) in this situation?","Choices":{"1":{"Display":"Rivera had much more resources"},"2":{"Display":"Rivera had slightly more resources"},"3":{"Display":"Both had equal resources"},"4":{"Display":"Martinez had slightly more resources"},"5":{"Display":"Martinez had much more resources"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID40"}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Alex Martinez is a world-renowned visual artist whose work has been featured in major internation...","TertiaryAttribute":null,"Payload":{"QuestionText":"Alex Martinez is <b>a world-renowned visual artist<\/b> whose work has been featured in major international museums. Martinez has a large following.<br><br>Recently, Martinez created a new artwork using a photograph originally taken by by Jamie Rivera, <b>a relatively unknown photographer <\/b>with a small following<b>.\n<\/b><br><br>Rivera's photograph showed a landscape scene. In the new artwork, Martinez changed the colors of Rivera's photograph and added text over it.<br><br>Martinez sold prints of this new collage for $500 each.\n<br><br>Martinez did not ask Rivera for permission or offer any payment. <br><br>When Rivera objected, Martinez stated that the new artwork was different enough from the original photograph that it should be legally protected as \"fair use.\"\n<br><br>Regardless, Martinez's artwork was displayed in a gallery.","DefaultChoices":false,"DataExportTag":"Famous - Small","QuestionID":"QID5","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex Martinez is a world-renowned visual artist whose work has been featured in major internation...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_6kXUb6tiH3Chlgq","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"How familiar are you with copyright law and \"fair use\"?","Tertia